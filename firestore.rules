rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 取引データ：全員が閲覧可能。
    // 作成・更新・削除は、竜太さんのGoogleアカウント（UID）でログインしている場合のみ許可。
    match /transactions/{txId} {
      allow read: if true;
      allow create, update: if request.auth != null
                             && request.auth.uid == 'D4ZDzT4bjlazjno8O0Xt93XujHo1'
                             && request.resource.data.keys().hasAll(['date', 'type', 'memo', 'amount']);
      allow delete: if false; // 削除は「deleted: true」への更新で行うため不要
    }
  }
}